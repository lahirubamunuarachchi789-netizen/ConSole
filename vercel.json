{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.mjs": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/assets/js/config.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/openrouter", "destination": "/api/proxy?route=openrouter" },
    { "source": "/api/groq", "destination": "/api/proxy?route=groq" },
    { "source": "/api/gemini", "destination": "/api/proxy?route=gemini" },
    { "source": "/health", "destination": "/api/proxy?route=health" }
  ]
}